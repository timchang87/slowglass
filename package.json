{
  "name": "refresh",
  "version": "1.0.0",
  "description": "Vite, React, Node, Express, TypeScript, SSL, and Docker",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "npm run test -ws --if-present",
    "test:changed": "npm run test:changed -ws --if-present",
    "test:coverage": "npm run test:coverage -ws --if-present",
    "test:e2e": "playwright test",
    "dev": "docker compose up --watch",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.+(js|ts|json|tsx|jsx|scss|html)\"",
    "types-check": "npm run types-check -ws --if-present"
  },
  "author": "timchang87",
  "license": "ISC",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "@typescript-eslint/parser": "^7.16.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.3.2"
  },
  "workspaces": [
    "client",
    "services/*",
    "packages/*"
  ]
}
