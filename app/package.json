{
  "name": "slowglass-app",
  "version": "0.1.0",
  "private": true,
  "description": "Slowglass Studio desktop shell",
  "main": "dist/main/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.e2e.json",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
